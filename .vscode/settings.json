json
{
  // กำหนดตำแหน่ง Python Interpreter ไปยัง Virtual Environment (.venv) ของโปรเจกต์
  "python.defaultInterpreterPath": "$`{workspaceFolder}/.venv/bin/python",

  // ตั้งค่าการจัดฟอร์แมตโค้ดอัตโนมัติเมื่อบันทึกไฟล์ด้วย Black
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "python.formatting.provider": "black",

  // เปิดใช้งานการตรวจเช็คข้อผิดพลาดและไวยากรณ์ด้วย Pylint
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,

  // ระบบวิเคราะห์โค้ด (Pylance): แนะนำคำสั่ง import อัตโนมัติและตรวจ Type ระดับพื้นฐาน
  "python.analysis.autoImportCompletions": true,
  "python.analysis.typeCheckingMode": "basic",

  // การทำความสะอาดไฟล์เมื่อบันทึก
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // ซ่อนโฟลเดอร์ระบบและไฟล์แคชของ Python เพื่อไม่ให้รกตาใน File Explorer
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.git": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  }
}
