# =============================================================================
# agent-hub — environment variables TEMPLATE
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# SECURITY:
#   - Variables WITHOUT the VITE_ prefix are SERVER-ONLY secrets. They must
#     never be read from client/browser code. If this app calls them from
#     frontend code, that is a leak — move that call behind a backend/proxy.
#   - Variables WITH the VITE_ prefix are baked into the public JS bundle at
#     build time. Only put non-secret, client-safe values there.
# =============================================================================

# ---- App / dev server ----
PORT=3000
NODE_ENV=development          # set to production automatically in CI build

# ---- LLM / AI (primary: OpenRouter) ----
# SECRET — server-only. Rotate if it was ever committed (it was, in .env).
OPENROUTER_API_KEY=sk-or-v1-replace-me
# Optional: default model to route through OpenRouter
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Optional alternative: direct Google GenAI (only if used instead of OpenRouter)
# GOOGLE_GENERATIVE_AI_API_KEY=AIza-replace-me

# ---- Backend API ----
# Client-safe base URL of your API (baked into bundle).
VITE_API_URL=http://localhost:8000/api
# SECRET — used by backend/CI to authenticate internal service calls.
INTERNAL_API_KEY=replace-with-long-random-string

# ---- Payments (Stripe) ----
# Client-safe publishable key (pk_...) — safe to expose in the bundle.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace-me
# SECRET — server-only. Never prefix with VITE_.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# ---- Base44 backend-as-a-service (@base44/sdk) ----
# Client-safe app ID (check base44 dashboard for exact var name).
VITE_BASE44_APP_ID=replace-me
# SECRET — server-only, if using server-side base44 admin SDK.
# BASE44_API_KEY=replace-me

# ---- Misc / feature flags (client-safe) ----
# VITE_APP_NAME=agent-hub
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=

# ---- CI / build only (set in GitHub Actions, not needed locally) ----
# NEXT_TELEMETRY_DISABLED=1   # legacy — this repo is Vite/webpack, not Next.js
